      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "vertical": {
      "$ref": "#/$defs/Vertical"
    },
    "agent": {
      "$ref": "#/$defs/AgentName"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "case_id",
    "vertical",
    "agent",
    "payload"
