    "AgentName": {
      "enum": [
        "ingestion",
        "analyst",
        "compliance",
        "manager",
        "audit"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "Vertical": {
      "enum": [
        "loan",
        "kyc_aml",
        "bnpl",
        "insurance",
        "dummy"
      ],
      "title": "Vertical",
